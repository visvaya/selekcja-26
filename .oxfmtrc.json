{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "pnpm-lock.yaml",
    "test-results/",
    "playwright-report/",
    "blob-report/",
    "src/logic/golden/traces/",
    "src/ui/text-snapshot.json"
  ]
}
