// Markdown lint. Markdown is not formatted by the code formatter: it renumbers
// ordered lists and realigns whole tables when one cell changes.
{
  "config": {
    "default": true,
    "MD013": false, // line length: prose and tables keep their lines
    "MD024": { "siblings_only": true }, // the same heading under different parents
    "MD060": { "style": "compact" }, // tables: one changed cell changes one line
  },
  // No "globs" here: they would be added to the files a command names.
  "ignores": [
    "**/node_modules/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
  ],
}
