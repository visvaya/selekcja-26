{
  "name": "selekcja-26",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:text": "node scripts/check-text.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "quality": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:text && pnpm check:conventions",
    "verify": "pnpm quality && pnpm test && pnpm build && git diff --check",
    "verify:full": "pnpm verify && pnpm test:e2e",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
