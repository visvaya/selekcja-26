{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    // node:test registers tests through the promises that test() and describe() return.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "name": ["test", "describe"],
            "package": "node:test"
          }
        ]
      }
    ],
    // Off outside the save boundary (override below): the other assertions narrow Object.keys,
    // DOM events and CSS custom properties, which the type system cannot express.
    "typescript/no-unsafe-type-assertion": "off",
    // tsc already checks returns against the declared types; this rule only flagged exhaustive
    // switches and effect cleanups.
    "typescript/consistent-return": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-effect-dependencies": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "import/no-cycle": "error",
    "no-console": "error",
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["src/logic/**", "src/data/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Game logic must use the seeded generator in src/logic/random.ts."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ui/*", "../ui/*"],
                "message": "src/logic and src/data must not depend on src/ui; pass UI copy in as a parameter."
              }
            ]
          }
        ]
      }
    },
    {
      // Saves come from storage the player controls; narrow them with checks, not assertions.
      "files": ["src/logic/save-format.ts", "src/logic/save-migration.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "error"
      }
    },
    {
      "files": ["src/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "test-results/**",
    "playwright-report/**"
  ]
}
