{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    // node:test registers tests through the promises that test() and describe() return.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "name": ["test", "describe"],
            "package": "node:test"
          }
        ]
      }
    ],
    // Off outside the save boundary (override below): the other assertions narrow Object.keys,
    // DOM events and CSS custom properties, which the type system cannot express.
    "typescript/no-unsafe-type-assertion": "off",
    // tsc already checks returns against the declared types; this rule only flagged exhaustive
    // switches and effect cleanups.
    "typescript/consistent-return": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-effect-dependencies": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    // Lists keyed by index are rendered once from immutable data and never reordered.
    "react/no-array-index-key": "off",
    // The suggested fixes mutate (Object.assign, push); the project builds new objects and
    // arrays instead, and the spread inputs are a handful of items.
    "oxc/no-map-spread": "off",
    "oxc/no-accumulating-spread": "off",
    "typescript/no-misused-promises": "error",
    "typescript/no-deprecated": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    // Size limits at the measured maximum (2026-11-15); lower them when a refactor allows.
    "complexity": ["error", { "max": 18 }],
    "max-lines-per-function": ["error", { "max": 206 }],
    "max-depth": ["error", { "max": 3 }],
    "max-params": ["error", { "max": 5 }],
    "max-nested-callbacks": ["error", { "max": 2 }],
    "max-lines": ["error", { "max": 559 }],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "import/no-cycle": "error",
    "no-console": "error",
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["src/logic/**", "src/data/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Game logic must use the seeded generator in src/logic/random.ts."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ui/*", "../ui/*"],
                "message": "src/logic and src/data must not depend on src/ui; pass UI copy in as a parameter."
              }
            ]
          }
        ]
      }
    },
    {
      // Saves come from storage the player controls; narrow them with checks, not assertions.
      "files": ["src/logic/save-format.ts", "src/logic/save-migration.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "error"
      }
    },
    {
      "files": ["src/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // Tests drive the UI step by step, so awaits in loops are sequential on purpose.
      "files": ["**/*.test.ts", "**/*.test.mjs", "e2e/**"],
      "rules": {
        "no-await-in-loop": "off",
        "max-lines-per-function": ["error", { "max": 245 }],
        "max-nested-callbacks": ["error", { "max": 5 }],
        "max-lines": ["error", { "max": 852 }]
      }
    },
    {
      // Outliers above the limits: the game reducer's action switch.
      "files": ["src/logic/state.ts"],
      "rules": {
        "complexity": ["error", { "max": 32 }]
      }
    },
    {
      // Outliers above the limits: the root UI container.
      "files": ["src/ui/game-app.tsx"],
      "rules": {
        "max-lines-per-function": ["error", { "max": 484 }]
      }
    },
    {
      // Outliers above the limits: the candidate records and their positional constructor.
      "files": ["src/data/catalog.ts"],
      "rules": {
        "max-params": ["error", { "max": 12 }],
        "max-lines": ["error", { "max": 964 }]
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "test-results/**",
    "playwright-report/**"
  ]
}
